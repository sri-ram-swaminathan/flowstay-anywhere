{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowstay",
  "version": "../package.json",
  "identifier": "io.github.sri-ram-swaminathan.flowstay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Flowstay",
        "url": "index.html",
        "width": 940,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "useHttpsScheme": true
      },
      {
        "label": "overlay",
        "title": "Flowstay overlay",
        "url": "overlay.html",
        "width": 260,
        "height": 56,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "On-device dictation with personas and custom vocabulary",
    "copyright": "Apache-2.0. Port of Flowstay by maketheproduct.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}