{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Flowstay windows",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "clipboard-manager:allow-write-text"
  ]
}